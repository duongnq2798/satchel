{
  "name": "satchel-nft",
  "version": "0.3.1",
  "description": "Check that a Satchel NFT, one wallet on 16 EVM chains signed through NEAR Chain Signatures, is provably clean before you buy it; mint, list, buy and send from one. A library and a CLI.",
  "license": "MIT",
  "author": "duongnq2798",
  "homepage": "https://satchelnft.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duongnq2798/satchel.git",
    "directory": "packages/satchel-nft"
  },
  "bugs": "https://github.com/duongnq2798/satchel/issues",
  "keywords": [
    "near",
    "chain-signatures",
    "nft",
    "evm",
    "mpc",
    "wallet"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "satchel-nft": "bin/satchel-nft.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "watch": "tsc -w -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "viem": "^2.57.17"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
