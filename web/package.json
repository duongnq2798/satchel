{
  "name": "satchel-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run build --prefix ../packages/satchel-nft",
    "dev": "next dev",
    "prebuild": "npm run build --prefix ../packages/satchel-nft",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "npm run build --prefix ../packages/satchel-nft",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --prefix ../packages/satchel-nft",
    "test": "vitest run",
    "preverify": "npm run build --prefix ../packages/satchel-nft",
    "verify": "satchel-nft verify"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.11.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "satchel-nft": "*",
    "viem": "2.57.17"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
